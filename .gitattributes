# Scripts shell en LF, sinon bash échoue sous Windows (core.autocrlf=true).
*.sh text eol=lf
gradlew text eol=lf

# Profil de référence généré par `./gradlew :app:generateBaselineProfile` (P5.17) : replié dans les
# revues et les diffs, compté comme généré par GitHub.
app/src/main/generated/** linguist-generated=true -diff

# Captures de référence (P5.8) : binaires, jamais touchées par la conversion des fins de ligne.
*.png binary

# Journal : chaque tâche ajoute sa ligne à la fin. En fusion « union », deux branches qui ajoutent chacune la leur
# ne se contredisent plus ; les deux lignes sont gardées, dans l'ordre des fusions.
JOURNAL.md merge=union
