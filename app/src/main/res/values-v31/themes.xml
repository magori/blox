<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        À partir d'Android 12, l'écran de démarrage du système : la page du thème Original et l'icône. Il reste
        affiché tant que MainActivity retient sa première image, le temps de lire le thème. LauncherIconTest le
        vérifie. Le fond de fenêtre vient du thème de base (values/themes.xml).
    -->
    <style name="Theme.Blox" parent="Base.Theme.Blox">
        <item name="android:windowSplashScreenBackground">@color/blox_window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
