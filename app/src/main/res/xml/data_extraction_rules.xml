<?xml version="1.0" encoding="utf-8"?>
<!--
    What the backup takes from Android 12 (API 31 and up). Its twin for API 26 to 30 is backup_rules.xml:
    change both together; BackupRulesTest checks them against the file names of core:data.

    A list of includes: only these files leave the device, anything else stays. Keep it so: a file
    that holds content URIs (a file of the user, as the music file of the home screen) must never be
    listed here, as its persistable permission (takePersistableUriPermission) does not move to another device.
    Nor the results of the daily challenge (DAILY_CHALLENGE_FILE): restored on another phone, a first try would
    no longer mean anything.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The record (RECORDS_FILE), apart from the settings. -->
        <include domain="file" path="datastore/records.preferences_pb" />
        <!-- The settings (SETTINGS_FILE): theme, music, start level. -->
        <include domain="file" path="datastore/settings.preferences_pb" />
        <!-- The saved musics (MUSICS_FILE): scores the player wrote, without a content URI. -->
        <include domain="file" path="datastore/musics.bin" />
    </cloud-backup>
    <device-transfer>
        <!-- The record (RECORDS_FILE), apart from the settings. -->
        <include domain="file" path="datastore/records.preferences_pb" />
        <!-- The settings (SETTINGS_FILE): theme, music, start level. -->
        <include domain="file" path="datastore/settings.preferences_pb" />
        <!-- The saved musics (MUSICS_FILE): scores the player wrote, without a content URI. -->
        <include domain="file" path="datastore/musics.bin" />
    </device-transfer>
</data-extraction-rules>
