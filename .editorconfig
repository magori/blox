root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin : lu par l'IDE (clés ij_*) et par ktlint (clés ktlint_*), pour que « Reformat » et
# `ktlintFormat` produisent le même code. Style IntelliJ (kotlin.code.style=official).
[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Paramètres de fonction sur plusieurs lignes dès deux paramètres, un par ligne
ij_kotlin_method_parameters_wrap = on_every_item
ij_kotlin_method_parameters_new_line_after_left_paren = true
ij_kotlin_method_parameters_right_paren_on_new_line = true
ktlint_code_style = intellij_idea
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
# Composables en PascalCase
ktlint_function_naming_ignore_when_annotated_with = Composable
# Imports inutilisés (P5.55) : la règle, dépréciée, ne tourne que si on l'active ici ; Kotlin ne
# signale pas un import inutile, et sans elle rien ne le verrait.
ktlint_standard_no-unused-imports = enabled

[*.{xml,toml,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
